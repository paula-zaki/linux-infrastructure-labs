Vagrant.configure("2") do |config|

  config.vm.define "lab4" do |lab4|
    lab4.vm.box = "generic/rocky9"
    lab4.vm.hostname = "lab4"

    lab4.vm.provider "libvirt" do |libvirt|
      libvirt.name = "lab4-libvirt"
      libvirt.memory = "3072"
      libvirt.cpus = 2

      libvirt.qemu_use_session = false
      libvirt.uri = "qemu:///system"
    end

    lab4.vm.network "private_network", ip: "192.168.56.110"

    lab4.vm.synced_folder ".", "/vagrant", type: "nfs", nfs_udp: false
  end

end
